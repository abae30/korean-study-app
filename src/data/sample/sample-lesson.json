  "paragraphs": [
    {
      "id": "l1-p-1",
      "title": "카페에서",
      "titleEn": "At the café",
      "kind": "dialogue",
      "lines": [
        {
          "speaker": "직원",
          "ko": "어서 오세요.",
          "en": "Welcome."
        },
        {
          "speaker": "손님",
          "ko": "커피 주세요.",
          "en": "Coffee, please."
        },
        {
          "speaker": "직원",
          "ko": "케이크도 있어요.",
          "en": "We have cake too."
        },
        {
          "speaker": "손님",
          "ko": "네, 케이크도 주세요.",
          "en": "Yes, cake too, please."
        },
        {
          "speaker": "손님",
          "ko": "얼마예요?",
          "en": "How much is it?"
        },
        {
          "speaker": "직원",
          "ko": "팔천 원이에요.",
          "en": "It's 8,000 won."
        },
        {
          "speaker": "손님",
          "ko": "감사합니다.",
          "en": "Thank you."
        }
      ],
      "source": "textbook",
      "lesson": 1
    },
    {
      "id": "l1-p-2",
      "title": "저는 카페에 가요",
      "titleEn": "I go to the café",
      "kind": "narration",
      "lines": [
        {
          "ko": "저는 카페에 가요.",
          "en": "I go to the café."
        },
        {
          "ko": "커피를 마셔요.",
          "en": "I drink coffee."
        },
        {
          "ko": "빵도 먹어요.",
          "en": "I eat bread too."
        },
        {
          "ko": "케이크가 아주 맛있어요.",
          "en": "The cake is really delicious."
        }
      ],
      "source": "textbook",
      "lesson": 1
    }
  ],
  "grammar": [
    {
      "id": "l1-g-1",
      "lesson": 1,
      "title": "The object particle 을/를",
      "pattern": "N을/를 V",
      "category": "particle",
      "explanation": "Attach 을/를 to the thing an action is done to. Use 을 after a consonant (빵을) and 를 after a vowel (커피를).",
      "examples": [
        {
          "ko": "커피를 마셔요.",
          "en": "I drink coffee."
        },
        {
          "ko": "빵을 먹어요.",
          "en": "I eat bread."
        }
      ]
    },
    {
      "id": "l1-g-please",
      "lesson": 1,
      "title": "Asking for something: N 주세요",
      "pattern": "N 주세요",
      "category": "ending",
      "explanation": "Put 주세요 after the thing you want to ask for. It means \"N, please\" (literally \"please give me N\").",
      "examples": [
        {
          "ko": "물 주세요.",
          "en": "Water, please."
        },
        {
          "ko": "메뉴 주세요.",
          "en": "The menu, please."
        }
      ]
    }
  ],
